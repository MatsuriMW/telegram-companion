{
    "name": "telegram-companion",
    "version": "1.0.6",
    "description": "Capture Telegram messages into your daily note, and chat with a bot that has read your recent notes. It keeps a profile note about you and works with the model you choose.",
    "keywords": [],
    "license": "GPL-3.0-only",
    "author": "MatsuriMW",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -p tsconfig.build.json -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "lint": "oxlint src",
        "test": "node --test --require tsx/cjs --require ./test/register-obsidian.cjs \"test/**/*.spec.ts\"",
        "check": "tsc --noEmit -skipLibCheck",
        "prepare": "husky",
        "lint:obsidian": "eslint ."
    },
    "dependencies": {
        "@telegraf/entity": "^0.5.0",
        "grammy": "^1.36.3",
        "mustache": "4.1.0",
        "obsidian-daily-notes-interface": "^0.9.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@eslint/json": "^2.1.1",
        "@types/mustache": "^4.2.6",
        "@types/node": "^25.2.2",
        "esbuild": "0.28.1",
        "eslint": "^9.39.5",
        "eslint-plugin-obsidianmd": "^0.4.2",
        "husky": "^9.1.7",
        "moment": "^2.31.0",
        "nano-staged": "^1.0.2",
        "obsidian": "^1.13.1",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.43.0",
        "tslib": "2.4.0",
        "tsx": "^4.23.0",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.71.1"
    },
    "nano-staged": {
        "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm oxfmt --write",
        "*.{ts,tsx}": "pnpm lint --fix"
    }
}
